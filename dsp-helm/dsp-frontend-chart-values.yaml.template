config:
  keycloak: 
    url: "https://keycloak.test.eanadev.org/auth"
    realm: "europeana"
    clientId: "edc-dashboard"
  
volumes:
  - name: config
    configMap:
      name: dsp-frontend-config
volumeMounts:
  - name: config
    mountPath: /app/config/edc-connector-config.json
    subPath: edc-connector-config.json
    readOnly: true